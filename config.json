{
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 20,
    "preset": "medium"
  },
  "story": {
    "defaultDurationSec": 26,
    "longDurationSec": 52,
    "ideaCount": 10
  },
  "ai": {
    "models": [
      "gemini-flash-lite-latest",
      "gemini-2.5-flash-lite",
      "gemini-2.0-flash-lite"
    ],
    "temperature": 0.9,
    "maxOutputTokens": 4096
  },
  "imagegen": {
    "enabled": true,
    "provider": "pollinations",
    "model": "flux",
    "models_allowed": [
      "flux",
      "turbo",
      "kontext",
      "gptimage"
    ],
    "width": 1024,
    "height": 1536,
    "timeoutSec": 120,
    "maxAttempts": 5,
    "backoffBaseSec": 3,
    "backoffMaxSec": 45,
    "outputDir": "assets/generated"
  },
  "audio": {
    "sampleRate": 44100,
    "musicGainDb": -6.0,
    "sfxGainDb": -6.0,
    "sfxPeakCapRatio": 0.7
  },
  "render": {
    "postprocessing": true,
    "depthOfField": true,
    "inkOutlines": true,
    "shadowQuality": 1024,
    "devicePixelRatio": 1
  }
}